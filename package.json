{
  "name": "@comput/pi-telnyx",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "license": "MIT",
  "author": "Martin Bundgaard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbundgaard/pi-telnyx.git"
  },
  "homepage": "https://github.com/mbundgaard/pi-telnyx#readme",
  "bugs": {
    "url": "https://github.com/mbundgaard/pi-telnyx/issues"
  },
  "description": "Telnyx Conversation Relay for an explicitly mapped Pi session: interruptible voice input and streamed public assistant text, with an optional Cloudflare Tunnel.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "telnyx",
    "conversation-relay",
    "websocket",
    "cloudflare-tunnel"
  ],
  "files": [
    "src/**/*.ts",
    "README.md",
    "docs/user-guide.md",
    "docs/conversation-relay-spec.md",
    "docs/development.md",
    "docs/deployment.md",
    "docs/releasing.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "npm run typecheck && npm test",
    "pack:check": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    }
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
